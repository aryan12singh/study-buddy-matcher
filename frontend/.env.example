# Copy to frontend/.env and fill in the values.
# .env is git-ignored. Never commit real credentials to this repository.
#
#   cp .env.example .env
#
# Vite reads this file automatically from the frontend directory, so no
# export step is needed. Only variables prefixed with VITE_ are exposed to the app, and
# anything exposed this way ends up in the built bundle and is readable by
# anyone using the site. Never put a secret in here.

# ---------------------------------------------------------------------------
# Where the React app looks for the API
# Local backend runs on http://localhost:8080
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# Optional background refresh interval in milliseconds (default: 30000).
# Supported range: minimum 15000, maximum 300000.
VITE_REFRESH_INTERVAL_MS=30000
