# Copy to backend/.env and fill in the values.
# .env is git-ignored. Never commit real credentials to this repository.
#
#   cp .env.example .env
#
# Spring Boot does NOT read .env files by itself. It reads the process
# environment. Export these before starting the app:
#
#   set -a && source .env && set +a
#   ./mvnw spring-boot:run
#
# Or set them in your IDE's run configuration instead.
#
# TODO: Team B: decide whether to keep the export step or add a dotenv
# library, and whether Windows teammates need a documented alternative to
# `source`.

# ---------------------------------------------------------------------------
# Supabase (hosted Postgres)
# Supabase > Project Settings > Database > Connection string
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---------------------------------------------------------------------------
# JWT signing
# Generate a long random value with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=
